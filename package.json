{
  "name": "tdl-gui-prototype",
  "version": "0.2.2",
  "private": true,
  "description": "HopeTDL GUI with comment-thread ordered forwarding and keyword filtering. - comment forward MSG_ID_INVALID fallback - skip post when no comments",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5174 && electron .\"",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.mjs",
    "build": "vite build",
    "start": "electron .",
    "build:dist": "npm run build && electron-builder",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "//dependencies": "主进程只用 Electron 内置模块，渲染端代码已被 vite 打包进 dist/，所以运行时不需要任何 npm 依赖。放在 dependencies 里的包会被 electron-builder 原样塞进安装包。",
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.7",
    "concurrently": "10.0.3",
    "electron": "42.3.3",
    "electron-builder": "26.15.2",
    "naive-ui": "2.44.1",
    "vite": "8.0.16",
    "vue": "3.5.35",
    "wait-on": "9.0.10"
  },
  "build": {
    "appId": "com.hope.tdlgui",
    "productName": "HopeTDL",
    "directories": {
      "output": "release",
      "buildResources": "assets/icons"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "assets/icons/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "assets/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icons/icon.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "icon": "assets/icons",
      "target": [
        "AppImage",
        "tar.gz"
      ]
    }
  }
}
