{
  "name": "tdl-gui-prototype",
  "version": "0.3.2",
  "private": true,
  "description": "HopeTDL: workflow-based Telegram transfers, comments, media and native Rust task scheduling",
  "main": "electron/main.cjs",
  "scripts": {
    "tauri": "tauri",
    "dev:rust": "tauri dev",
    "dev:web": "vite",
    "build:rust": "tauri build",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "dev": "tauri dev",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.mjs",
    "build": "vite build",
    "start": "tauri dev",
    "build:dist": "tauri build",
    "build:mac": "tauri build --bundles app,dmg",
    "build:win": "tauri build --bundles nsis",
    "build:linux": "tauri build",
    "dev:electron": "concurrently -k \"vite\" \"wait-on tcp:5174 && electron .\"",
    "start:electron": "electron .",
    "build:electron": "npm run build && electron-builder"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@vitejs/plugin-vue": "6.0.7",
    "concurrently": "10.0.3",
    "electron": "42.3.3",
    "electron-builder": "26.15.2",
    "naive-ui": "2.44.1",
    "vite": "8.0.16",
    "vue": "3.5.35",
    "wait-on": "9.0.10"
  },
  "build": {
    "appId": "com.hope.tdlgui",
    "productName": "HopeTDL",
    "directories": {
      "output": "release",
      "buildResources": "assets/icons"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "assets/icons/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "assets/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icons/icon.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "icon": "assets/icons",
      "target": [
        "AppImage",
        "tar.gz"
      ]
    }
  }
}
